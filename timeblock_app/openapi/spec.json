{
  "openapi": "3.0.3",
  "info": {
    "title": "Mini App Service API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5173"
    }
  ],
  "paths": {
    "/hello": {
      "post": {
        "operationId": "sayHello",
        "summary": "生成问候语",
        "description": "根据调用方传入的 foo 与 bar 字段生成一条确定性问候语，用于验证 service API 基础请求链路。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SayHelloRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SayHelloResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SayHelloRequest": {
        "type": "object",
        "properties": {
          "foo": {
            "type": "string"
          },
          "bar": {
            "type": "string"
          }
        },
        "required": [
          "foo",
          "bar"
        ]
      },
      "SayHelloResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ]
      }
    }
  }
}
