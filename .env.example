# ===== 必须 =====
# 端口（本地默认 5173，线上可改）
PORT=5173

# ===== 生产部署 =====
# NODE_ENV=production 时：
#   - demo seed 自动关闭（避免 demo1234 弱密码泄漏）
#   - cookie 自动加 Secure 标志
NODE_ENV=development

# ===== CORS 白名单 =====
# 生产必须显式设；本地默认已含 localhost:5173 / localhost:3000
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# ===== 数据库 =====
# 默认 data/lingua.db（相对 server/ 目录）
# LINGUA_DB=/var/lib/lingua/prod.db

# ===== Cookie =====
# 生产 HTTPS 必须加 Secure；开发可设 0
COOKIE_SECURE=0
COOKIE_SAMESITE=Lax

# ===== 功能开关 =====
# 社区示例用户 + 帖子（仅开发环境开；生产必须关）
ENABLE_DEMO_SEED=1

# ===== 日志 =====
# debug / info / warn / error
LOG_LEVEL=info
