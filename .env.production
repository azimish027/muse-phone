# ============================
# 语缪 Musē Phōnē · 生产环境变量
# ============================
# 部署前 cp .env.production .env 再修改
#
# 安全提示：
#   - .env 在 .gitignore 里，不会进仓库 ✅
#   - CORS_ORIGINS 逗号分隔，必须包含你的生产域名 + 任何 CDN/前端域名
#   - ENABLE_DEMO_SEED=0 确保 demo1234 弱密码账号不会被创建

# --- 基础 ---
NODE_ENV=production
PORT=5173

# --- 域名 ---
# 主域名（certbot 会为这个域名申请证书）
DOMAIN=muse-phone.yourdomain.com
# 备选域名（www），可选，留空则 certbot 只申主域名
DOMAIN_ALT=

# --- CORS 白名单 ---
# 必须包含所有前端域名；生产 CDN/子域也要加
CORS_ORIGINS=https://muse-phone.yourdomain.com,https://www.yourdomain.com

# --- HTTPS / Cookie ---
# 生产必须开 — 强制 Set-Cookie: Secure
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax

# --- 功能开关 ---
# 生产必须关 — 不要 demo 用户（demo1234）
ENABLE_DEMO_SEED=0
# 生产默认关；只有你想手动重置种子时才开
# LINGUA_RESEED=1

# --- Certbot 邮箱（到期提醒）---
CERTBOT_EMAIL=admin@yourdomain.com

# --- 日志 ---
# debug / info / warn / error
LOG_LEVEL=info

# --- 数据库 ---
# Docker 方式：保留默认即可（挂载到 /app/data）
# 裸机 PM2 方式：改成绝对路径
# LINGUA_DB=/var/lib/muse-phone/lingua.db

# --- gzip ---
ENABLE_GZIP=1
